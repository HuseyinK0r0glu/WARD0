# Unity project lives in Game/. Patterns below match at any depth.

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data should be committed, but not for ignored generated folders
# (.meta files are intentionally NOT ignored)

# IDE / generated project files
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig
*.DotSettings.user

# Unity crash / profiler / build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Auto-generated by Unity tooling
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
Game/Assets/Plugins/Editor/JetBrains*
InitTestScene*.unity*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local Claude Code settings / secrets
.claude/settings.local.json
.env
*.key

# Office temp/lock files
~$*
